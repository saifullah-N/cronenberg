{
  "name": "cronenberg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && npm run -s scanner:typecheck",
    "test": "vitest run",
    "scan": "node scanner/src/cli.ts",
    "scanner:test": "vitest run --config scanner/vitest.config.ts",
    "scanner:typecheck": "tsc --noEmit -p scanner",
    "db:migrate:local": "wrangler d1 migrations apply cronenberg --local",
    "db:migrate:remote": "wrangler d1 migrations apply cronenberg --remote",
    "db:seed:local": "wrangler d1 execute cronenberg --local --file seeds/brands.sql",
    "db:seed:remote": "wrangler d1 execute cronenberg --remote --file seeds/brands.sql",
    "label:export": "node scripts/label-export.mjs",
    "label:import": "node scripts/label-import.mjs"
  },
  "dependencies": {
    "tldts": "^7.4.16",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "~1.3.4",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@cyclonedx/cyclonedx-library": "~10.3",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "typescript": "~5.9",
    "vitest": "~4.1.11",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "workerd@1.20260930.2": true,
    "esbuild@0.28.1": true
  }
}
